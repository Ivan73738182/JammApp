<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Комната создана!"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ваш код для входа:"
        android:textSize="16sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvRoomCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="000000"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#03DAC5"
        android:letterSpacing="0.2"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnGoToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Перейти к плейлисту"
        android:textSize="18sp"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Новая кнопка "Поделиться" -->
    <Button
        android:id="@+id/btnShareCode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Поделиться кодом"
        android:textSize="18sp"
        android:backgroundTint="#03DAC5"
        android:textColor="#121212"/>

</LinearLayout>
