<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp">

    <!-- Верхняя панель с заголовком и кнопкой + -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Плейлист"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAddTrack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#121212"
            android:background="@drawable/btn_neon_cyan"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Код комнаты -->
    <TextView
        android:id="@+id/tvPlaylistCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Код комнаты: 000000"
        android:textSize="16sp"
        android:textColor="#03DAC5"
        android:layout_below="@id/topBar"
        android:layout_marginBottom="16dp" />

    <!-- Список треков -->
    <ListView
        android:id="@+id/lvTracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvPlaylistCode"
        android:layout_above="@id/bottomPlayer"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp"/>

    <!-- Мини-плеер внизу -->
    <LinearLayout
        android:id="@+id/bottomPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_track_card"
        android:padding="12dp"
        android:layout_marginTop="8dp">

        <!-- Кнопка плей/пауза -->
        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⏸"
            android:textSize="20sp"
            android:textColor="#121212"
            android:background="@drawable/btn_neon_cyan"
            android:stateListAnimator="@null"
            android:layout_marginEnd="12dp"/>

        <!-- Информация о треке (название и артист) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNowPlayingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ничего не играет"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvNowPlayingArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
