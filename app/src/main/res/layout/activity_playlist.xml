<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Плейлист"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvPlaylistCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Код: 000000"
        android:textSize="16sp"
        android:textColor="#03DAC5"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/lvTracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#333333"
        android:dividerHeight="1dp" />

    <EditText
        android:id="@+id/etTrackUrl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/btn_neon_purple"
        android:paddingHorizontal="16dp"
        android:hint="Вставьте ссылку на mp3"
        android:textColorHint="#AAAAAA"
        android:textColor="#FFFFFF"
        android:inputType="textUri"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnAddTrack"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="+ Добавить"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_neon_purple"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="⏸ Пауза"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#121212"
            android:background="@drawable/btn_neon_cyan"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</LinearLayout>
