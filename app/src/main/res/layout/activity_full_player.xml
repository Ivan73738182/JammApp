<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="←"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent"
        android:layout_gravity="start"/>

    <androidx.cardview.widget.CardView
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/ivFullCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvFullTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название песни"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFullArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Исполнитель"
        android:textSize="16sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="32dp"/>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#03DAC5"
        android:thumbTint="#03DAC5"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="#AAAAAA"/>
        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#AAAAAA"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="⏮"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/btnPlayPauseFull"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_pause"
            android:background="@drawable/btn_neon_cyan"
            android:scaleType="centerInside"
            android:layout_marginHorizontal="24dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="⏭"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@android:color/transparent"/>
    </LinearLayout>

</LinearLayout>
