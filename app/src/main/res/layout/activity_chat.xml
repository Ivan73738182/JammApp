<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="16dp"
    android:paddingBottom="32dp"> <!-- Добавили отступ снизу для всего экрана -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Чат комнаты"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Список сообщений (занимает всё свободное место) -->
    <ListView
        android:id="@+id/lvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:transcriptMode="alwaysScroll"/>

    <!-- Поле ввода и кнопка (в самом низу, с отступом) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"> <!-- Добавили отступ снизу для панели -->

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/btn_neon_purple"
            android:paddingHorizontal="16dp"
            android:hint="Сообщение..."
            android:textColorHint="#AAAAAA"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="50dp"
            android:text="→"
            android:textSize="24sp"
            android:textColor="#121212"
            android:background="@drawable/btn_neon_cyan"/>
    </LinearLayout>

</LinearLayout>
